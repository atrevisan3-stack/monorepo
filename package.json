{
  "name": "monorepo-tiers-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Exemplo de monorepo organizado por tiers de criticidade",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "start:tier-1": "npm run start --workspace=@tiers-demo/tier-1-api",
    "start:tier-2": "npm run start --workspace=@tiers-demo/tier-2-notifications",
    "start:tier-3": "npm run start --workspace=@tiers-demo/tier-3-analytics",
    "start:dashboard": "npm run start --workspace=@tiers-demo/dashboard",
    "simulate:tier-1-failure": "node scripts/simulate-tier-1-failure.js"
  },
  "engines": {
    "node": ">=20"
  }
}
